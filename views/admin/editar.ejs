<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>Admin | Editar</title>
  <link rel="stylesheet" href="/styles.css"/>
</head>
<body>
  <main class="wrap">
    <div class="header">
      <h2 style="margin:0">Editor de unidades</h2>
      <div style="display:flex;gap:8px">
        <a class="btn" href="/admin/reportes">Reportes</a>
        <a class="btn" href="/admin/logout">Salir</a>
      </div>
    </div>

    <% if (typeof toast !== 'undefined' && toast) { %>
      <div class="alert"><%= toast.msg %></div>
    <% } %>

    <% if (typeof avisos !== 'undefined' && avisos && avisos.length) { %>
      <div class="alert warn"><strong>Avisos:</strong> <%= avisos.length %> documento(s) por vencer o vencidos.</div>
    <% } %>

    <section class="card">
      <form method="get" action="/admin/editar">
        <div class="grid">
          <label>Placa
            <input name="placa" value="<%= (typeof placa !== 'undefined' && placa) ? placa : '' %>" placeholder="Ej: S36612" required/>
          </label>
        </div>
        <button class="btn" type="submit">Cargar</button>
      </form>
    </section>

    <% if (typeof placa !== 'undefined' && placa) { %>

      <section class="card">
        <h3 style="margin-top:0">Datos de la unidad</h3>
        <form method="post" action="/admin/editar">
          <input type="hidden" name="placa" value="<%= placa %>"/>
          <div class="grid">
            <label>Unidad <input name="unidad" value="<%= (truck && truck.unidad) ? truck.unidad : '' %>"/></label>
            <label>CEDIS <input name="cedis" value="<%= (truck && truck.cedis) ? truck.cedis : '' %>"/></label>
            <label>Marca <input name="marca" value="<%= (truck && truck.marca) ? truck.marca : '' %>"/></label>
            <label>Modelo <input name="modelo" value="<%= (truck && truck.modelo) ? truck.modelo : '' %>"/></label>
            <label>Año <input name="anio" value="<%= (truck && truck.anio) ? truck.anio : '' %>"/></label>
            <label>VIN <input name="vin" value="<%= (truck && truck.vin) ? truck.vin : '' %>"/></label>
            <label>Tel. Quejas <input name="telefono_quejas" value="<%= (truck && truck.telefono_quejas) ? truck.telefono_quejas : '' %>"/></label>
            <label>Notas (separa con ;) <input name="notas" value="<%= (truck && truck.notas && truck.notas.length) ? truck.notas.join('; ') : '' %>"/></label>
          </div>
          <button class="btn" type="submit">Guardar</button>
        </form>
      </section>

      <section class="card">
        <h3 style="margin-top:0">Portada</h3>
        <% if (truck && truck.foto) { %>
          <div style="margin-bottom:8px">
            <img src="<%= truck.foto %>" alt="Portada" style="width:160px;height:120px;object-fit:cover;border:1px solid #20304d;border-radius:8px"/>
          </div>
        <% } else { %>
          <p class="muted">Sin portada.</p>
        <% } %>
        <form method="post" action="/admin/cover/upload" enctype="multipart/form-data" style="margin-top:8px">
          <input type="hidden" name="placa" value="<%= placa %>"/>
          <label>Subir nueva portada
            <input type="file" name="portada" accept=".jpg,.jpeg,.png,.webp,.gif" required/>
          </label>
          <button class="btn" type="submit">Actualizar portada</button>
        </form>
      </section>

      <section class="card">
        <h3 style="margin-top:0">Galería</h3>
        <form method="post" action="/admin/upload" enctype="multipart/form-data">
          <input type="hidden" name="placa" value="<%= placa %>"/>
          <label>Imágenes (puedes elegir varias)
            <input type="file" name="archivos" accept=".jpg,.jpeg,.png,.webp,.gif" multiple required/>
          </label>
          <button class="btn" type="submit">Subir</button>
        </form>

        <% if (typeof fotos !== 'undefined' && fotos && fotos.length) { %>
          <div class="gallery" style="margin-top:12px">
            <% fotos.forEach(function(f){ %>
              <figure class="fig">
                <img class="responsive" src="<%= f.url %>" alt="foto"/>
                <!-- Portada -->
                <form method="post" action="/admin/photo/cover" style="display:flex;gap:6px;padding:8px">
                  <input type="hidden" name="placa" value="<%= placa %>"/>
                  <input type="hidden" name="photo_id" value="<%= f.id %>"/>
                  <button class="btn" type="submit">Portada</button>
                </form>
                <!-- Eliminar -->
                <form method="post" action="/admin/photo/delete" style="display:flex;gap:6px;padding:0 8px 8px">
                  <input type="hidden" name="placa" value="<%= placa %>"/>
                  <input type="hidden" name="photo_id" value="<%= f.id %>"/>
                  <button class="btn" type="submit">Eliminar</button>
                </form>
                <!-- Reemplazar -->
                <form method="post" action="/admin/photo/replace" enctype="multipart/form-data" style="display:flex;gap:6px;padding:0 8px 12px">
                  <input type="hidden" name="placa" value="<%= placa %>"/>
                  <input type="hidden" name="photo_id" value="<%= f.id %>"/>
                  <input type="file" name="nuevo" accept=".jpg,.jpeg,.png,.webp,.gif" required/>
                  <button class="btn" type="submit">Reemplazar</button>
                </form>
              </figure>
            <% }); %>
          </div>
        <% } else { %>
          <p class="muted">Sin imágenes.</p>
        <% } %>
      </section>

      <section class="card">
        <h3 style="margin-top:0">Documentos</h3>

        <form method="post" action="/admin/doc/add" style="margin-bottom:8px">
          <input type="hidden" name="placa" value="<%= placa %>"/>
          <div class="grid">
            <label>Categoría <input name="categoria" required/></label>
            <label>Título <input name="titulo" required/></label>
            <label>Fecha de vencimiento <input type="date" name="fecha_vencimiento" required/></label>
            <label>URL (opcional) <input name="url" placeholder="/file/:id o http(s)://"/></label>
          </div>
          <button class="btn" type="submit">Agregar</button>
        </form>

        <form method="post" action="/admin/doc/upload" enctype="multipart/form-data" style="margin-bottom:8px">
          <input type="hidden" name="placa" value="<%= placa %>"/>
          <div class="grid">
            <label>Categoría <input name="categoria" placeholder="Seguro / Soat / RTV" required/></label>
            <label>Título <input name="titulo" placeholder="Póliza 2025" required/></label>
            <label>Fecha de vencimiento <input type="date" name="fecha_vencimiento" required/></label>
            <label>Imagen <input type="file" name="archivo" accept=".jpg,.jpeg,.png,.webp,.gif" required/></label>
          </div>
          <button class="btn" type="submit">Subir documento</button>
        </form>

        <% if (typeof docs !== 'undefined' && docs && docs.length) { %>
          <table class="table">
            <thead>
              <tr><th>Cat.</th><th>Título</th><th>Vence</th><th>Estado</th><th>Acciones</th></tr>
            </thead>
            <tbody>
              <% docs.forEach(function(d){ %>
                <tr>
                  <td><%= d.categoria %></td>
                  <td><%= d.titulo %></td>
                  <td><%= d.fecha_vencimiento ? d.fecha_vencimiento : '-' %></td>
                  <td>
                    <% if (d.estado === 'vencido') { %>
                      <span class="badge danger">Vencido</span>
                    <% } else if (d.estado === 'por-vencer') { %>
                      <span class="badge warn">Por vencer (<%= d.dias %> d)</span>
                    <% } else if (d.estado === 'vigente') { %>
                      <span class="badge ok">Vigente</span>
                    <% } else { %>
                      <span class="badge">Sin fecha</span>
                    <% } %>
                  </td>
                  <td>
                    <form method="post" action="/admin/doc/delete" style="display:inline">
                      <input type="hidden" name="placa" value="<%= placa %>"/>
                      <input type="hidden" name="id" value="<%= d.id %>"/>
                      <button class="btn" type="submit">Eliminar</button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        <% } else { %>
          <p class="muted">Sin documentos.</p>
        <% } %>
      </section>

    <% } %>
  </main>
</body>
</html>
